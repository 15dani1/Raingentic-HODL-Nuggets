# Rain API credentials (server-side only — never expose to the client bundle)
RAIN_API_KEY=your_rain_api_key_here
RAIN_USER_ID=your_rain_user_id_here
RAIN_TEAM_ID=your_rain_team_id_here
RAIN_COLLATERAL_CONTRACT_ID=your_rain_collateral_contract_id_here
RAIN_API_BASE_URL=https://api.rain.xyz

# Monad RPC (testnet by default)
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
