# Rain sandbox API credentials (server-side only — never expose to the
# client bundle). These match the vars used by rain_demo.py.
RAIN_API_KEY=your_rain_api_key_here
RAIN_USER_ID=your_rain_user_id_here
RAIN_CONTRACT_ID=your_rain_collateral_contract_id_here
RAIN_API_BASE_URL=https://api-dev.raincards.xyz/v1

# Optional: only needed if a Rain endpoint you use is scoped per-team.
RAIN_TEAM_ID=your_rain_team_id_here

# Optional: existing ACH -> USDC/Base payment route id in the sandbox.
# Defaults to the one hardcoded in rain_demo.py / src/backend/rain/client.ts
# if not set.
RAIN_ONRAMP_ROUTE_ID=f9ddcfc8-4254-49f8-b973-9f1cbcd3ffc7

# Monad RPC (testnet by default)
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143

# Optional: Monad testnet USDC test token address (from the hackathon
# builder one-pager). Defaults to the value below if not set.
MONAD_USDC_CONTRACT=0x534b2f3A21130d7a60830c2Df862319e593943A3
